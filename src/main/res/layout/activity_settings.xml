<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── BÖLÜM: Kapasite ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SAKLAMA KAPASİTESİ"
            android:textSize="11sp"
            android:textColor="@color/colorPrimary"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:paddingBottom="8dp" />

        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/cardBackground"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Mevcut kayıt sayısı -->
                <TextView
                    android:id="@+id/tvCurrentCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Şu an kayıtlı: 0 / 100 mesaj"
                    android:textSize="14sp"
                    android:textColor="@color/textSecondary"
                    android:paddingBottom="16dp" />

                <!-- SeekBar etiketi -->
                <TextView
                    android:id="@+id/tvSeekLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Orta (100)"
                    android:textSize="13sp"
                    android:textColor="@color/textPrimary"
                    android:paddingBottom="8dp" />

                <!-- SeekBar -->
                <SeekBar
                    android:id="@+id/seekBarMaxHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="99"
                    android:progress="9"
                    android:paddingBottom="16dp" />

                <!-- Manuel giriş -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Veya değer girin (10-1000):"
                    android:textSize="13sp"
                    android:textColor="@color/textSecondary"
                    android:paddingBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Maksimum mesaj sayısı"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMaxHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="4"
                        android:text="100" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Hızlı seçim -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hızlı seçim:"
                    android:textSize="13sp"
                    android:textColor="@color/textSecondary"
                    android:paddingBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <Button
                        android:id="@+id/btnPreset50"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="50"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnPreset100"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="100"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnPreset200"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="200"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnPreset500"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="500" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ayarı Kaydet"
                    android:backgroundTint="@color/colorPrimary" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── BÖLÜM: İzinler ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="İZİNLER VE GÜVENLİK"
            android:textSize="11sp"
            android:textColor="@color/colorPrimary"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:paddingBottom="8dp" />

        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/cardBackground"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bildirim erişimi olmadan uygulama çalışmaz. Aşağıdan izin durumunu kontrol edebilirsiniz."
                    android:textSize="13sp"
                    android:textColor="@color/textSecondary"
                    android:paddingBottom="12dp" />

                <Button
                    android:id="@+id/btnPermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bildirim Erişim Ayarları" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── BÖLÜM: Tehlikeli Alan ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TEHLİKELİ BÖLGE"
            android:textSize="11sp"
            android:textColor="@color/colorDanger"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:paddingBottom="8dp" />

        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/cardBackground"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <Button
                    android:id="@+id/btnClearAll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tüm Geçmişi Temizle"
                    android:backgroundTint="@color/colorDanger" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
